# CargoGuard AI — Backend Environment Variables
# Copy to .env and fill in values before running

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CargoGuard AI
APP_ENV=development           # development | production
DEBUG=true

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Redis (session store) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=7200      # 2 hours — claim data cleared after this

# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Zenduit ───────────────────────────────────────────────────────────────────
ZENDUIT_API_BASE=https://api.zenduit.com/v1
ZENDUIT_API_KEY=your-zenduit-api-key

# ── xentag ────────────────────────────────────────────────────────────────────
XENTAG_API_BASE=https://api.xentag.com/v1
XENTAG_API_KEY=your-xentag-api-key

# ── Adapter mode ──────────────────────────────────────────────────────────────
# Set to true to use fixture data instead of live API calls (development default)
USE_MOCK_ADAPTERS=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PACKAGES_PER_HOUR=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── File upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
MAX_SESSION_FILES_MB=100
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,heic

# ── Fraud detection threshold ─────────────────────────────────────────────────
# Fraud agent returns null score until this many labeled outcomes exist
FRAUD_MIN_CLAIMS_THRESHOLD=500
